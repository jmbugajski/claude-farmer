# --- Farm Water Analysis ---

# Downloaded EcoWitt daily-log exports (raw data, not source code)
inputs/*
!inputs/.gitkeep

# Generated dashboards (produced by lib/build_dashboard.py).
# The dated files in outputs/ are local build artifacts and stay untracked —
# git history of the committed docs/index.html already preserves every past
# version. docs/index.html is the stable copy served publicly via GitHub Pages.
outputs/*
!outputs/.gitkeep

# macOS cruft
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/
